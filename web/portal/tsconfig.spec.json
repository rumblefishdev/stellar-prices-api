{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts"
    ],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    // `base-path.spec.ts` imports `../vite.config.mts` to assert the build's
    // real `base` value. Bundler resolution will not find that file from an
    // extensionless path, and this target only ever emits declarations, which is
    // the condition TypeScript attaches to this option.
    "allowImportingTsExtensions": true,
    // Vitest globals need `dom` for the rendered tree; without it `lib` falls
    // back to the target's default and `Element.textContent` and friends are
    // missing in spec files only.
    "lib": ["dom", "esnext"]
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
