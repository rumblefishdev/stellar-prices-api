{
  "envName": "production",
  "awsRegion": "eu-central-1",
  "apiGatewayThrottleRate": 50,
  "apiGatewayThrottleBurst": 100,
  "apiGatewayPartnerDailyQuota": 10000,
  "scheduleExpressions": {
    "assetSupply": "rate(1 hour)",
    "oracleWatcher": "rate(5 minutes)",
    "assetDiscovery": "rate(1 hour)",
    "cleanup": "cron(0 3 * * ? *)"
  },
  "ledgerProcessor": {
    "memoryMb": 512,
    "timeoutSeconds": 60,
    "reservedConcurrency": 1,
    "sqsBatchSize": 1,
    "maxReceiveCount": 10,
    "maxIterations": 16
  }
}
